# Copy to .env locally. Never put this key in Flutter assets or --dart-define.
# Empty key => "Mô phỏng AI" mode: rule-based extraction, no speech recognition.
OPENAI_API_KEY=
# auto (default): openai when a key is set, otherwise mock. mock | openai force a mode.
SMART_MODE=auto
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-live-transcribe
MAX_OUTPUT_TOKENS=1200

# Local USB development only (adb reverse tcp:8080 tcp:8080).
HOST=127.0.0.1
PORT=8080

# Limits enforced by the server (PRD §10).
MAX_RECORDING_SECONDS=60
MAX_AUDIO_BYTES=5242880
MAX_SESSION_AUDIO_SECONDS=300
MODEL_CALLS_PER_MINUTE=12
MODEL_TIMEOUT_MS=20000
SESSION_IDLE_MINUTES=30
MAX_SESSIONS=20

# Clinic database and doctor web (bước 14). Relative paths start at backend/.
CLINIC_DB=data/clinic.db
DOCTOR_WEB_DIR=../doctor_web/build/web
# Only while running `flutter run -d web-server` on another port, e.g. http://localhost:5000
DOCTOR_WEB_DEV_ORIGIN=
# 1 when served over HTTPS: the staff cookie gets Secure.
HTTPS=0
# Password of the demo doctor created by `npm run seed`.
DEMO_PASSWORD=medicapp-demo
# Fixed claim code for the seeded result of p1 (demo only), e.g. K7MQ-4XR2-9D. Empty: random.
SEED_CLAIM_CODE=
# Patient sign-in (bước 16). No SMS provider yet.
# dev (default unless NODE_ENV=production): the code is logged and returned as devCode. off: 503 otp_unavailable.
PATIENT_OTP_MODE=dev
# Demo only, dev mode only: fixed sign-in code for the seeded phones (0912 + patient code), e.g. 000000. Empty: random.
DEMO_OTP=
# Server secret for hashing sign-in codes. Empty uses a dev default; required when NODE_ENV=production.
PATIENT_OTP_PEPPER=
# Pre-visit summary for the doctor (bước 17). auto (default): openai when OPENAI_API_KEY is set, otherwise mock.
# off: no summary is made. mock: rule-based, no model. openai: OPENAI_MODEL with Structured Outputs, store=false.
CLINIC_AI_SUMMARY=auto
# Quiet time after an intake upload before the summary runs; uploads within it make one run.
SUMMARY_DEBOUNCE_MS=3000
