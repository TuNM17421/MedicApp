# Copy to .env locally. Never put this key in Flutter assets or --dart-define.
# Empty key => "Mô phỏng AI" mode: rule-based extraction, no speech recognition.
OPENAI_API_KEY=
# auto (default): openai when a key is set, otherwise mock. mock | openai force a mode.
SMART_MODE=auto
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-live-transcribe
MAX_OUTPUT_TOKENS=1200

# Local USB development only (adb reverse tcp:8080 tcp:8080).
HOST=127.0.0.1
PORT=8080

# Limits enforced by the server (PRD §10).
MAX_RECORDING_SECONDS=60
MAX_AUDIO_BYTES=5242880
MAX_SESSION_AUDIO_SECONDS=300
MODEL_CALLS_PER_MINUTE=12
MODEL_TIMEOUT_MS=20000
SESSION_IDLE_MINUTES=30
MAX_SESSIONS=20
