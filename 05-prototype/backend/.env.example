# Configuration template only. The backend is not implemented yet.
# Copy to .env locally. Never put this key in Flutter assets or --dart-define.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_STT_MODEL=gpt-live-transcribe

# Proposed local development configuration; application-specific variables.
HOST=127.0.0.1
PORT=8080
MAX_RECORDING_SECONDS=60
# Proposed per-turn cap. The conversation needs a separate session limit.
MAX_AUDIO_BYTES=5242880
